# Private, confidential & generated artifacts
# NOTE: .gitignore ONLY blocks untracked files; it does NOT protect files already tracked in Git.
# Per BO decisions DEC-07/DEC-08 (see docs/decisions/decision-register.md &
# docs/governance/confidentiality-and-rights-policy.md), private/sources/ (7 issuer PDFs) is
# currently tracked; redistribution rights are tracked per-file in knowledge/sources/source-registry.csv.
# All other files under private/ remain ignored and must NEVER be staged into this PUBLIC repository.
private/*
!private/sources/
!private/sources/**
*.secret
*.key
*.pem
.env
.env.*

# Office / Excel temporary, lock & test-rebuild files
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx
*.tmp
outputs/working/*_rebuilt.xlsx

# OS & Editor artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python cache & virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local browser / cache dumps
*.har
cookies.txt
