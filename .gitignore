# Private, confidential & generated artifacts
# NOTE: .gitignore ONLY blocks untracked files; it does NOT protect files already tracked in Git.
# DEC-22 (2026-11-28): TJ chose to track the 9 source PDFs in private/sources/ in this PUBLIC repo so
# every machine gets them with git pull (replaces DEC-11). Anything else under private/ stays untracked.
private/*
!private/sources/
*.secret
*.key
*.pem
.env
.env.*

# Office / Excel temporary, lock & test-rebuild files
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx
*.tmp
outputs/working/*_rebuilt.xlsx

# OS & Editor artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python cache & virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local browser / cache dumps
*.har
cookies.txt


# Ảnh trang tách từ PDF (232 MB, sinh lại y hệt bằng qa/source-reading/extract_pages.py từ 9 PDF trong repo); chữ tách theo trang VẪN commit
qa/source-reading/work/img/
