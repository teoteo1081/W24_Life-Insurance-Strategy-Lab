# Private, confidential & generated artifacts
# NOTE: .gitignore ONLY blocks untracked files; it does NOT protect files already tracked in Git.
# DEC-11 (2026-11-26): the 7 issuer PDFs in private/sources/ are no longer tracked. They stay on
# TJ's machine for local analysis and are served for evidence links from Cloudflare R2 via the
# read-only Worker in infra/evidence-worker/ (see manifest.json). Earlier Git history still contains them.
private/
*.secret
*.key
*.pem
.env
.env.*

# Office / Excel temporary, lock & test-rebuild files
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx
*.tmp
outputs/working/*_rebuilt.xlsx

# OS & Editor artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python cache & virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local browser / cache dumps
*.har
cookies.txt
