# Mẫu cấu hình — chép thành file `.env` ở GỐC repo (đã được .gitignore chặn) rồi điền giá trị thật.
# KHÔNG commit file .env. KHÔNG đưa SUPABASE_SERVICE_KEY vào HTML/JS.

# Dùng cho scripts/sync_to_supabase.py (ghi dữ liệu — bỏ qua RLS):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key>

# Dùng cho scripts/build_html.py (nhúng vào trang để ĐỌC — công khai, được RLS bảo vệ):
W24_SUPABASE_URL=https://<project-ref>.supabase.co
W24_SUPABASE_ANON_KEY=<anon key>
